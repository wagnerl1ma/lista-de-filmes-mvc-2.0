@model IEnumerable<ListaDeFilmes.App.ViewModels.GeneroViewModel>

@{
    ViewData["Title"] = "Lista de Generos";
}

<vc:Summary></vc:Summary>

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-theater-masks"></i> G&ecirc;neros
    </h1>
    <a class="btn btn-primary" disable-by-claim-name="Generos" disable-by-claim-value="Adicionar" asp-action="Create">
        <i class="fas fa-plus"></i> Novo G&ecirc;nero
    </a>
</div>

<div id="FilmeTarget">
    <table class="cinema-table table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th class="text-right">A&ccedil;&otilde;es</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>
                    <td class="text-right">
                        <a class="btn btn-info btn-sm" asp-controller="Generos" asp-action="DetailsModal" asp-route-id="@item.Id" data-modal="" title="Detalhes">
                            <i class="fas fa-search"></i>
                        </a>
                        <a class="btn btn-warning btn-sm" disable-by-claim-name="Generos" disable-by-claim-value="Editar" asp-controller="Generos" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                            <i class="fas fa-pencil-alt"></i>
                        </a>
                        <a class="btn btn-danger btn-sm" disable-by-claim-name="Generos" disable-by-claim-value="Excluir" asp-controller="Generos" asp-action="Delete" asp-route-id="@item.Id" title="Excluir">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="myModal" class="modal fade in cinema-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            SetModal();
        });
    </script>
}
