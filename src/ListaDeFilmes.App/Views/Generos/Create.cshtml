@model ListaDeFilmes.App.ViewModels.GeneroViewModel

@{
    ViewData["Title"] = "Novo Genero";
}

<div class="row mt-4">
    <div class="col-md-6 mx-auto">
        <div class="cinema-form">
            <div class="cinema-form__header">
                <i class="fas fa-plus-circle"></i>
                <div>
                    <h2>Novo G&ecirc;nero</h2>
                    <p class="cinema-form__subtitle">Adicione um novo g&ecirc;nero de filme</p>
                </div>
            </div>

            <form asp-action="Create">

                <vc:Summary></vc:Summary>

                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Nome do genero" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <hr class="cinema-divider" />

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Cadastrar
                    </button>
                    <a class="btn btn-outline-cinema ml-2" asp-action="Index">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
