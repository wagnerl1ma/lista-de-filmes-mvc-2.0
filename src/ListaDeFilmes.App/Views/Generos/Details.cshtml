@model ListaDeFilmes.App.ViewModels.GeneroViewModel

@{
    ViewData["Title"] = "Detalhe do Genero - " + Model.Nome;
}

<div class="mt-4">
    <h1 class="page-title">
        <i class="fas fa-theater-masks"></i> @Model.Nome
    </h1>

    <div class="cinema-form" style="max-width: 500px;">
        <ul class="filme-detail__meta mb-0">
            <li class="filme-detail__meta-item" style="border-bottom: none;">
                <i class="fas fa-theater-masks"></i>
                <span class="filme-detail__meta-label">Nome</span>
                <span class="filme-detail__meta-value">@Model.Nome</span>
            </li>
        </ul>
    </div>

    <div class="mt-3">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="fas fa-pencil-alt"></i> Editar
        </a>
        <a class="btn btn-outline-cinema ml-2" href="javascript:window.history.back();">
            <i class="fas fa-arrow-left"></i> Voltar
        </a>
    </div>
</div>
