@model ListaDeFilmes.App.ViewModels.GeneroViewModel

@{
    ViewData["Title"] = "Editar Genero";
}

<div class="row mt-4">
    <div class="col-md-6 mx-auto">
        <div class="cinema-form">
            <div class="cinema-form__header">
                <i class="fas fa-pencil-alt"></i>
                <div>
                    <h2>Editar G&ecirc;nero</h2>
                    <p class="cinema-form__subtitle">Atualize o nome do g&ecirc;nero</p>
                </div>
            </div>

            <form asp-action="Edit">

                <vc:Summary></vc:Summary>

                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <hr class="cinema-divider" />

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Salvar
                    </button>
                    <a class="btn btn-outline-cinema ml-2" href="javascript:window.history.back();">
                        <i class="fas fa-arrow-left"></i> Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
