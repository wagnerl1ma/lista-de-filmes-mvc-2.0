@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link nav-link-auth" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gerenciar conta">
            <i class="fas fa-user-circle"></i> @User.Identity?.Name
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link nav-link-auth">
                <i class="fas fa-sign-out-alt"></i> Sair
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link nav-link-auth" asp-area="Identity" asp-page="/Account/Register">
            <i class="fas fa-user-plus"></i> Cadastrar
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link nav-link-auth" asp-area="Identity" asp-page="/Account/Login">
            <i class="fas fa-sign-in-alt"></i> Entrar
        </a>
    </li>
}
</ul>
