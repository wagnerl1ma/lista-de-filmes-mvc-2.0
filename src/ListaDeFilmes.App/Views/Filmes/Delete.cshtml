@model ListaDeFilmes.App.ViewModels.FilmeViewModel

@{
    ViewData["Title"] = "Excluir " + Model.Nome;
}

<div class="mt-4">
    <div class="cinema-delete-confirm">
        <div class="cinema-delete-confirm__header">
            <i class="fas fa-exclamation-triangle"></i>
            <h4>Excluir Filme</h4>
        </div>

        <p class="cinema-delete-confirm__question">
            Tem certeza que deseja excluir <strong>@Model.Nome</strong>? Esta acao nao pode ser desfeita.
        </p>

        <div class="row">
            <div class="col-md-4 mb-3 text-center">
                <div class="cinema-delete-confirm__poster-wrapper">
                    <img src="~/imagens/@Model.Imagem" alt="@Model.Nome" />
                </div>
            </div>
            <div class="col-md-8">
                <ul class="filme-detail__meta">
                    <li class="filme-detail__meta-item">
                        <i class="fas fa-film"></i>
                        <span class="filme-detail__meta-label">Nome</span>
                        <span class="filme-detail__meta-value">@Model.Nome</span>
                    </li>
                    @if (Model.Genero != null)
                    {
                        <li class="filme-detail__meta-item">
                            <i class="fas fa-theater-masks"></i>
                            <span class="filme-detail__meta-label">G&ecirc;nero</span>
                            <span class="filme-detail__meta-value">@Model.Genero.Nome</span>
                        </li>
                    }
                    @if (Model.Ano.HasValue)
                    {
                        <li class="filme-detail__meta-item">
                            <i class="fas fa-calendar-alt"></i>
                            <span class="filme-detail__meta-label">Ano</span>
                            <span class="filme-detail__meta-value">@Model.Ano</span>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Classificacao))
                    {
                        <li class="filme-detail__meta-item">
                            <i class="fas fa-star"></i>
                            <span class="filme-detail__meta-label">Classifica&ccedil;&atilde;o</span>
                            <span class="filme-detail__meta-value">@Model.Classificacao</span>
                        </li>
                    }
                    <li class="filme-detail__meta-item">
                        <i class="fas fa-tag"></i>
                        <span class="filme-detail__meta-label">Valor</span>
                        <span class="filme-detail__meta-value">@Model.Valor.ToString("C2").Replace("$", "$ ")</span>
                    </li>
                </ul>

                <div class="cinema-delete-confirm__actions">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Excluir
                        </button>
                        <a class="btn btn-outline-cinema" href="javascript:window.history.back();">
                            <i class="fas fa-arrow-left"></i> Cancelar
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
