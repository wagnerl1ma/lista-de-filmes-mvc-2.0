@model IEnumerable<ListaDeFilmes.App.ViewModels.FilmeViewModel>

@if (!Model.Any())
{
    <div class="cinema-empty-state">
        <i class="fas fa-film"></i>
        <h4>Nenhum filme cadastrado</h4>
        <p>Comece adicionando seu primeiro filme!</p>
        <a class="btn btn-primary" asp-action="Create">
            <i class="fas fa-plus"></i> Adicionar Filme
        </a>
    </div>
}
else
{
    <div class="filme-grid">
        @foreach (var item in Model)
        {
            <div class="filme-card">
                <div class="filme-card__poster-wrapper">
                    <img src="~/imagens/@item.Imagem"
                         alt="@item.Nome"
                         class="filme-card__poster" />

                    @if (item.Ativo)
                    {
                        <span class="filme-card__status filme-card__status--ativo" title="Ativo"></span>
                    }
                    else
                    {
                        <span class="filme-card__status filme-card__status--inativo" title="Inativo"></span>
                    }

                    <div class="filme-card__overlay">
                        <div class="filme-card__actions">
                            <a class="btn-action btn-action--info"
                               asp-controller="Filmes"
                               asp-action="DetailsModal"
                               asp-route-id="@item.Id"
                               data-modal=""
                               title="Detalhes">
                                <i class="fas fa-search"></i>
                            </a>
                            <a class="btn-action btn-action--warning"
                               disable-by-claim-name="Filmes"
                               disable-by-claim-value="Editar"
                               asp-controller="Filmes"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               title="Editar">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a class="btn-action btn-action--danger"
                               disable-by-claim-name="Filmes"
                               disable-by-claim-value="Excluir"
                               asp-controller="Filmes"
                               asp-action="Delete"
                               asp-route-id="@item.Id"
                               title="Excluir">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="filme-card__body">
                    <h5 class="filme-card__title" title="@item.Nome">@item.Nome</h5>
                    <div class="filme-card__meta">
                        @if (item.Genero != null)
                        {
                            <span class="filme-card__badge">@item.Genero.Nome</span>
                        }
                        @if (item.Ano.HasValue)
                        {
                            <span class="filme-card__year">@item.Ano</span>
                        }
                    </div>
                    <div class="filme-card__footer">
                        <span class="filme-card__rating" title="Classificacao: @item.Classificacao">
                            @item.Classificacao
                        </span>
                        <span class="filme-card__price">
                            @item.Valor.ToString("C2").Replace("$", "$ ")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
