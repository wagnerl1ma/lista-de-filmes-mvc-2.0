@model IEnumerable<ListaDeFilmes.App.ViewModels.FilmeViewModel>

@{
    ViewData["Title"] = "Lista de Filmes";
}

<vc:Summary></vc:Summary>

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-video"></i> Lista de Filmes
    </h1>
    <a class="btn btn-primary" disable-by-claim-name="Filmes" disable-by-claim-value="Adicionar" asp-action="Create">
        <i class="fas fa-plus"></i> Novo Filme
    </a>
</div>

<div id="FilmeTarget">
    <partial name="_ListaFilmes" />
</div>

<div id="myModal" class="modal fade in cinema-modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div id="myModalContent"></div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            SetModal();
        });
    </script>
}
