@page
@model ListaDeFilmes.App.Areas.Identity.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Redefinir Senha";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <i class="fas fa-lock-open auth-card__icon"></i>
            <h2 class="auth-card__title">Redefinir Senha</h2>
            <p class="auth-card__subtitle">Digite sua nova senha</p>
        </div>

        <div class="auth-card__body">
            <form id="reset-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="Input.Code" type="hidden" />

                <div class="form-group">
                    <label asp-for="Input.Email" class="cinema-form__label">
                        <i class="fas fa-envelope"></i> E-mail
                    </label>
                    <input asp-for="Input.Email" class="form-control cinema-form__input"
                           autocomplete="username" placeholder="seu@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password" class="cinema-form__label">
                        <i class="fas fa-lock"></i> Nova Senha
                    </label>
                    <input asp-for="Input.Password" class="form-control cinema-form__input"
                           autocomplete="new-password" placeholder="Minimo 6 caracteres" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword" class="cinema-form__label">
                        <i class="fas fa-lock"></i> Confirmar Nova Senha
                    </label>
                    <input asp-for="Input.ConfirmPassword" class="form-control cinema-form__input"
                           autocomplete="new-password" placeholder="Repita a nova senha" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block auth-btn">
                    <i class="fas fa-save"></i> Redefinir Senha
                </button>

                <div class="auth-links">
                    <a asp-page="./Login">
                        <i class="fas fa-arrow-left"></i> Voltar para o login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
