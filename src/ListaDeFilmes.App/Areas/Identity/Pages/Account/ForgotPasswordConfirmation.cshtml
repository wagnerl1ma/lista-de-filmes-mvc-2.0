@page
@model ListaDeFilmes.App.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Confirmacao de recuperacao de senha";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <i class="fas fa-check-circle auth-card__icon" style="color: #2aa198;"></i>
            <h2 class="auth-card__title">E-mail enviado</h2>
            <p class="auth-card__subtitle">Verifique seu e-mail para redefinir sua senha</p>
        </div>

        <div class="auth-card__body" style="text-align: center;">
            <p style="color: var(--cinema-text-muted); margin-bottom: 1.5rem;">
                Se o e-mail informado estiver cadastrado, voce recebera um link para redefinir sua senha.
            </p>

            <a asp-page="./Login" class="btn btn-primary auth-btn" style="display: inline-block; width: auto; padding: 0.6rem 2rem;">
                <i class="fas fa-sign-in-alt"></i> Voltar para o login
            </a>
        </div>
    </div>
</div>
