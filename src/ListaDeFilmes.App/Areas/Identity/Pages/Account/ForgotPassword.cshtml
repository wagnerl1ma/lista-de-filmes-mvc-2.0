@page
@model ListaDeFilmes.App.Areas.Identity.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Esqueceu sua senha";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <i class="fas fa-key auth-card__icon"></i>
            <h2 class="auth-card__title">Esqueceu sua senha?</h2>
            <p class="auth-card__subtitle">Informe seu e-mail para redefinir a senha</p>
        </div>

        <div class="auth-card__body">
            <form id="forgot-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="Input.Email" class="cinema-form__label">
                        <i class="fas fa-envelope"></i> E-mail
                    </label>
                    <input asp-for="Input.Email" class="form-control cinema-form__input" autocomplete="username" placeholder="seu@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block auth-btn">
                    <i class="fas fa-paper-plane"></i> Enviar
                </button>

                <div class="auth-links">
                    <a asp-page="./Login">
                        <i class="fas fa-arrow-left"></i> Voltar para o login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
