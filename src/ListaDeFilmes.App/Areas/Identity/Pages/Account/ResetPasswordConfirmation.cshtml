@page
@model ListaDeFilmes.App.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Senha Redefinida";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <i class="fas fa-check-circle auth-card__icon" style="color: #2aa198;"></i>
            <h2 class="auth-card__title">Senha Redefinida</h2>
            <p class="auth-card__subtitle">Sua senha foi redefinida com sucesso</p>
        </div>

        <div class="auth-card__body" style="text-align: center;">
            <p style="color: var(--cinema-text-muted); margin-bottom: 1.5rem;">
                Agora voce pode fazer login com sua nova senha.
            </p>

            <a asp-page="./Login" class="btn btn-primary auth-btn" style="display: inline-block; width: auto; padding: 0.6rem 2rem;">
                <i class="fas fa-sign-in-alt"></i> Ir para o login
            </a>
        </div>
    </div>
</div>
