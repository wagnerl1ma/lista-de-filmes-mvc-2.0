@page
@model ListaDeFilmes.App.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Cadastrar";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <i class="fas fa-user-plus auth-card__icon"></i>
            <h2 class="auth-card__title">Criar Conta</h2>
            <p class="auth-card__subtitle">Cadastre-se para gerenciar seus filmes</p>
        </div>

        <div class="auth-card__body">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="Input.Email" class="cinema-form__label">
                        <i class="fas fa-envelope"></i> E-mail
                    </label>
                    <input asp-for="Input.Email" class="form-control cinema-form__input" autocomplete="username" placeholder="seu@email.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password" class="cinema-form__label">
                        <i class="fas fa-lock"></i> Senha
                    </label>
                    <input asp-for="Input.Password" class="form-control cinema-form__input" autocomplete="new-password" placeholder="Minimo 6 caracteres" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword" class="cinema-form__label">
                        <i class="fas fa-lock"></i> Confirmar Senha
                    </label>
                    <input asp-for="Input.ConfirmPassword" class="form-control cinema-form__input" autocomplete="new-password" placeholder="Repita a senha" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button id="registerSubmit" type="submit" class="btn btn-primary btn-block auth-btn">
                    <i class="fas fa-user-plus"></i> Cadastrar
                </button>

                <div class="auth-links">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">
                        <i class="fas fa-sign-in-alt"></i> Ja tem uma conta? Entrar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
